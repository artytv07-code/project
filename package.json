{
  "name": "odin-osobennyi-vecher",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Один особенный вечер — кинематографичное приглашение на вечернюю прогулку по Гомелю",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch": "node tools/fetch-assets.mjs",
    "process": "node tools/process-images.mjs",
    "assets": "node tools/fetch-assets.mjs && node tools/process-images.mjs",
    "music": "node tools/generate-music.mjs",
    "og": "node tools/generate-og.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
